# Generate a key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me
DEBUG=True
# Comma-separated, e.g. localhost,127.0.0.1
ALLOWED_HOSTS=

# Cloud PostgreSQL (kosongkan jika ingin memakai SQLite lokal)
# Contoh: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

